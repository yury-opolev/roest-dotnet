<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DanishVoice.Native</RootNamespace>
    <AssemblyName>DanishVoice.Native</AssemblyName>
    <!-- NuGet packaging metadata -->
    <PackageId>DanishVoice.Native</PackageId>
    <Version>0.2.0</Version>
    <Description>Native in-process Danish TTS (CoRal Røst-v3) via ONNX Runtime. No Python at inference.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- GPU package is a superset of the CPU package: CUDA EP when available, CPU otherwise. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DanishVoice.Native.Cli" />
  </ItemGroup>

</Project>
